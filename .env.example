# Database (MySQL)
DATABASE_URL="mysql://barbara:barbara123@localhost:3306/barbara_db"

# JWT
JWT_SECRET="troque-por-um-secret-longo-e-aleatorio"
JWT_REFRESH_SECRET="troque-por-outro-secret-longo-e-aleatorio"

# AWS S3 (mesmo padrão do Kimo)
S3_ACCESS_KEY="AKIAXXXXXXXXXXXXXXXX"
S3_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
S3_BUCKET="barbara-assets"
S3_REGION="sa-east-1"
S3_PUBLIC_URL=""          # opcional: CDN ou URL pública do bucket

# S3_ENDPOINT só definir se usar MinIO local (deixe vazio para AWS real)
# S3_ENDPOINT="http://localhost:9000"

# App
PORT=3000
NODE_ENV=development
